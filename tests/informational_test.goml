package tests;

use ecosystem::websocket as ws;
use std::bytes;
use std::context;
use std::net;
use std::task;
use std::testing;
use std::time;

fn upgrade_after_information(request: ws::ClientRequest) -> bytes::Bytes {
    let head = bytes::Bytes::from_string(
        "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 102 Processing\r\n\r\nHTTP/1.1 103 Early Hints\r\nLink: </asset>\r\n\r\nHTTP/1.1 199 Information\r\n\r\n",
    );
    let parsed = testing::expect_ok(ws::ServerRequest::parse(request.encode(), 16384), "request");
    head.extend_from_slice(
        testing::expect_ok(parsed.response(Option::Some("chat")), "upgrade").as_slice(),
    );
    head.extend_from_slice(
        testing::expect_ok(ws::encode_frame(text_frame("ready"), Option::None), "frame").as_slice(),
    );
    head
}

#[test]
fn informational_handshake_preserves_short_reads_and_coalesced_frames() -> () {
    for size in[1, 3, 8192] {
        let request = request();
        let stream = memory(upgrade_after_information(request), size, 3);
        let (connection, selected) = testing::expect_ok(
            ws::client(
                ws::Transport::from_io(stream),
                request,
                ws::Limits::standard(),
                context::Context::background(),
            ),
            "upgrade after informational responses",
        );
        defer {
            let _ = connection.abort();
        };
        testing::assert_eq(testing::expect_some(selected, "protocol"), "chat");
        testing::assert_eq(receive_text(connection, context::Context::background()), "ready");
    }
}

#[test]
fn informational_handshake_uses_a_cumulative_header_budget() -> () {
    let request = request();
    let input = upgrade_after_information(request);
    let total = input.len() - 7; // Five payload bytes and a two-byte frame header.
    for size in[1, 8192] {
        for extra in[-1, 0] {
            let stream = memory(input, size, 8192);
            let result = ws::client(
                ws::Transport::from_io(stream),
                request,
                ws::Limits { handshake_bytes: total + extra, ..ws::Limits::standard() },
                context::Context::background(),
            );
            if extra == 0 {
                let (connection, _) = testing::expect_ok(result, "exact aggregate header limit");
                defer {
                    let _ = connection.abort();
                };
                testing::assert_eq(
                    receive_text(connection, context::Context::background()),
                    "ready",
                );
            } else {
                testing::assert_eq(
                    testing::expect_err(result, "aggregate header limit").kind,
                    ws::ErrorKind::Limit,
                );
                testing::assert(stream.closed.get());
            }
        }
    }
}

#[test]
fn informational_handshake_still_requires_a_valid_final_upgrade() -> () {
    for final in[
        "HTTP/1.1 403 Forbidden\r\n\r\n",
        "HTTP/1.1 101 Switching Protocols\r\n\r\n",
        "HTTP/1.1 1x3 Invalid\r\n\r\n",
        "HTTP/1.1 103 Early Hints\r\nBad Header: value\r\n\r\n",
    ] {
        let input = bytes::Bytes::from_string("HTTP/1.1 103 Early Hints\r\n\r\n" + final);
        let stream = memory(input, 8192, 8192);
        let result = ws::client(
            ws::Transport::from_io(stream),
            request(),
            ws::Limits::standard(),
            context::Context::background(),
        );
        testing::assert_eq(
            testing::expect_err(result, "invalid final response").kind,
            ws::ErrorKind::Handshake,
        );
        testing::assert(stream.closed.get());
    }
    let stream = memory(bytes::Bytes::from_string("HTTP/1.1 103 Early Hints\r\n\r\n"), 8192, 8192);
    testing::assert_eq(
        testing::expect_err(
            ws::client(
                ws::Transport::from_io(stream),
                request(),
                ws::Limits::standard(),
                context::Context::background(),
            ),
            "EOF before upgrade",
        ).kind,
        ws::ErrorKind::UnexpectedEof,
    );
    testing::assert(stream.closed.get());
}

#[test]
fn informational_handshake_works_over_tcp() -> () {
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_seconds(5),
        |ctx, _| {
            let listener = testing::expect_ok(
                net::TcpListener::bind(
                    testing::expect_ok(net::SocketAddr::parse("127.0.0.1:0"), "address"),
                ),
                "listener",
            );
            defer {
                let _ = listener.close();
            };
            let address = testing::expect_ok(listener.local_addr(), "local address");
            let request = request();
            task::scope(
                |scope| {
                    let _ = scope.spawn(
                        |_| {
                            let stream = testing::expect_ok(
                                listener.accept_with(net::WaitOptions::new().with_context(ctx)),
                                "accept",
                            ).0;
                            defer {
                                let _ = stream.close();
                            };
                            let head = testing::expect_ok(
                                ws::HandshakeDecoder::new(16384),
                                "head decoder",
                            );
                            let byte = Vec::from_array([0]);
                            while head.head().is_none() {
                                testing::expect_ok(
                                    stream.read_exact_with(
                                        byte.as_mut_slice(),
                                        net::WaitOptions::new().with_context(ctx),
                                    ),
                                    "request bytes",
                                );
                                testing::expect_ok(head.push(byte.as_slice()), "request head");
                            }
                            testing::expect_ok(
                                stream.write_all_with(
                                    upgrade_after_information(request).as_slice(),
                                    net::WaitOptions::new().with_context(ctx),
                                ),
                                "responses and frame",
                            );
                        },
                    );
                    let stream = testing::expect_ok(
                        net::TcpStream::connect_with(
                            address,
                            net::WaitOptions::new().with_context(ctx),
                        ),
                        "connect",
                    );
                    let (connection, _) = testing::expect_ok(
                        ws::client(ws::Transport::tcp(stream), request, ws::Limits::standard(), ctx),
                        "TCP upgrade",
                    );
                    defer {
                        let _ = connection.abort();
                    };
                    testing::assert_eq(receive_text(connection, ctx), "ready");
                },
            );
        },
    );
}
