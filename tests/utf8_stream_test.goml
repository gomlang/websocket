package tests;

use ecosystem::websocket as ws;
use std::bytes;
use std::testing;

#[test]
fn invalid_text_prefix_fails_before_fin() -> () {
    for payload in[b"\xc0", b"\x80", b"\xf5", b"\xe0\x9f", b"\xed\xa0", b"\xf0\x8f", b"\xf4\x90"] {
        let client = session(ws::Role::Client);
        feed(client, ws::Opcode::Text, false, bytes::Bytes::from_vec(payload));
        equal(
            testing::expect_err(client.next(), "invalid prefix before FIN").kind,
            ws::ErrorKind::Utf8,
        );
        equal(client.state(), ws::State::Failed);
    }
    let client = session(ws::Role::Client);
    feed(client, ws::Opcode::Text, false, bytes::Bytes::from_vec(b"\xe0"));
    testing::assert_none(testing::expect_ok(client.next(), "incomplete scalar"));
    feed(client, ws::Opcode::Continuation, false, bytes::Bytes::from_vec(b"\x9f"));
    equal(
        testing::expect_err(client.next(), "invalid continuation before FIN").kind,
        ws::ErrorKind::Utf8,
    );
}

#[test]
fn legal_scalar_boundaries_survive_every_split_and_control_frames() -> () {
    let text = "\u0080\u07ff\u0800\ud7ff\ue000𐀀􏿿";
    let encoded = bytes::Bytes::from_string(text);
    for split in 0..encoded.len() + 1 {
        let client = session(ws::Role::Client);
        feed(
            client,
            ws::Opcode::Text,
            false,
            bytes::Bytes::from_slice_copy(encoded.slice(0, split)),
        );
        testing::assert_none(testing::expect_ok(client.next(), "fragment"));
        feed(client, ws::Opcode::Ping, true, bytes::Bytes::from_vec(b"\xff"));
        testing::assert_some(testing::expect_ok(client.next(), "binary ping payload"));
        feed(client, ws::Opcode::Pong, true, bytes::Bytes::from_vec(b"\xff"));
        testing::assert_some(testing::expect_ok(client.next(), "binary pong payload"));
        feed(
            client,
            ws::Opcode::Continuation,
            true,
            bytes::Bytes::from_slice_copy(encoded.slice(split, encoded.len())),
        );
        equal(next_text(client), text);
        feed(client, ws::Opcode::Text, true, bytes::Bytes::from_string("next"));
        equal(next_text(client), "next");
    }
    let client = session(ws::Role::Client);
    feed(client, ws::Opcode::Text, false, bytes::Bytes::from_vec(b"\xf0\x90"));
    testing::assert_none(testing::expect_ok(client.next(), "incomplete scalar"));
    feed(client, ws::Opcode::Continuation, true, bytes::Bytes::new());
    equal(testing::expect_err(client.next(), "unfinished scalar at FIN").kind, ws::ErrorKind::Utf8);
    let client = session(ws::Role::Client);
    feed(client, ws::Opcode::Binary, true, bytes::Bytes::from_vec(b"\xff"));
    testing::assert_some(testing::expect_ok(client.next(), "binary is not UTF8"));
}
